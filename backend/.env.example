# Project root (holds src/, models/*.onnx, experiments/gloss.csv); override only if elsewhere.
# RECOGNITION_ROOT=.

SPOTER_ONNX_NAME=models/spoter_multicam_v3.onnx
GLOSS_CSV_NAME=experiments/gloss.csv
SPOTER_NUM_CLASSES=400
SPOTER_SEQ_LEN=70
SPOTER_CONFIDENCE_THRESHOLD=0.60
# ONNX providers in priority order (JSON); intersected with what's available.
SPOTER_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=10.0

# TTS (VieNeu); sample rate below is a fallback, actual rate comes from the engine at runtime.
TTS_MODE=standard
TTS_SAMPLE_RATE=24000

SESSION_STRIDE=10

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ALLOW_ORIGINS=["*"]
